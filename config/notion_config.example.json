{
  "enabled": true,
  "api_key": "YOUR_NOTION_API_KEY_HERE",
  "databases": {
    "求職者DB": {
      "database_id": "YOUR_DATABASE_ID_HERE",
      "description": "求職者の基本情報を管理（重複チェックあり）",
      "check_duplicate_by": "TEL",
      "properties": {
        "求職者名": "title",
        "フリガナ": "rich_text",
        "TEL": "phone_number",
        "メールアドレス": "email",
        "生年月日": "date",
        "性別": "select",
        "居住地": "rich_text"
      }
    },
    "応募DB": {
      "database_id": "YOUR_DATABASE_ID_HERE",
      "description": "各応募の詳細情報（毎回追記）",
      "properties": {
        "求職者名": "relation",
        "応募日時": "date",
        "応募媒体": "select",
        "応募企業": "rich_text",
        "応募勤務地": "rich_text"
      }
    }
  }
}
